[Unit]
Description=OhBoyScan - auditoria contínua do roteador MikroTik (ECDSA P-256)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ohboyscan -c /etc/ohboyscan/ohboyscan.conf daemon --interval 300
Restart=on-failure
RestartSec=10
# Endurecimento: o daemon só precisa LER chaves públicas/preset e escrever log.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/ohboyscan /run
ReadOnlyPaths=/var/lib/ohboyscan /etc/ohboyscan

[Install]
WantedBy=multi-user.target
